# Copy to .env (git-ignored) and run with: uv run --env-file .env docintel ...
ANTHROPIC_API_KEY=
# Other providers, if you install their extra (uv sync --extra openai, google, aws, ollama):
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# AWS_ACCESS_KEY_ID= AWS_SECRET_ACCESS_KEY= AWS_DEFAULT_REGION=
# Defaults the CLI flags fall back to:
# DOCINTEL_EXTRACTOR=model
# DOCINTEL_MODEL=anthropic:claude-sonnet-5-5
# DOCINTEL_VISION_MODEL=        # model for page transcription; defaults to DOCINTEL_MODEL
# DOCINTEL_OCR=1
# DOCINTEL_MAX_CONCURRENCY=4
# Tracing, optional:
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
